{
  "name": "grimore",
  "version": "1.0.0",
  "description": "Premium All-Encompassing MTG Suite Web Server",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=768 server.js",
    "dev": "node --max-old-space-size=768 server.js",
    "build": "npm run build:web",
    "build:web": "npm --prefix web run build",
    "test:recommendations": "node --test test/recommendation-engine.test.js",
    "test:multiplayer": "node --test test/multiplayer-engine.test.js",
    "test:unit": "node --test test/recommendation-engine.test.js test/multiplayer-engine.test.js test/maintenance-scripts.test.js test/billing-gating.test.js",
    "preflight": "node scripts/preflight.js",
    "v2:build": "turbo run build --filter=./packages/* --filter=./apps/*",
    "v2:typecheck": "turbo run typecheck --filter=./packages/* --filter=./apps/*",
    "v2:test": "turbo run test --filter=./packages/* --filter=./apps/*",
    "v2:guards": "node scripts/guards.js",
    "v2:migrate": "pnpm --filter @grimore/db migrate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "connect-redis": "^9.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^10.9.1",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "packageExtensions": {
      "@socket.io/redis-streams-adapter": {
        "peerDependencies": {
          "redis": "^4.6.5"
        },
        "peerDependenciesMeta": {
          "redis": {
            "optional": false
          }
        }
      }
    }
  }
}

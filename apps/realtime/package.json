{
  "name": "@grimore/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --enable-source-maps --watch dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@grimore/rules-engine": "workspace:*",
    "@grimore/shared": "workspace:*",
    "@socket.io/redis-streams-adapter": "^0.2.2",
    "pino": "^9.5.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

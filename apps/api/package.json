{
  "name": "@grimore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --enable-source-maps --watch dist/server.js",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@grimore/auto-tagger": "workspace:*",
    "@grimore/db": "workspace:*",
    "@grimore/shared": "workspace:*",

# Grimore Environment Configuration File
# Copy this to a file named .env before running docker-compose.
# NEVER commit the real .env, and never put real secrets in this example file.

# Whitelisted Moxfield crawler credential to bypass Cloudflare (obtain from Moxfield).
MOXFIELD_USER_AGENT="MoxKey; YourAppName YOUR_MOXFIELD_KEY"

# Session signing secret — REQUIRED in production. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SECRET"

# Google OAuth client id for Sign in with Google.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# Gemini API key for the "Grim" AI rules advisor / AI opponent.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Postgres password (must match the value used by the postgres service).
POSTGRES_PASSWORD="YOUR_POSTGRES_PASSWORD"

# Admin account bootstrap (a random password is generated if ADMIN_PASSWORD is unset).
ADMIN_USER="YOUR_ADMIN_USERNAME"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# Google Cloud Platform VM Deployment Configuration
VM_IP="YOUR_VM_IP"
VM_USER="YOUR_VM_USERNAME"

# --- Premium billing (Stripe, TEST MODE) — all optional; absent = premium disabled, no crash ---
# Gating is OFF unless PREMIUM_GATING=on. Install the SDK with `npm install stripe` before enabling.
STRIPE_SECRET_KEY="sk_test_YOUR_TEST_KEY"
STRIPE_PRICE_ID="price_YOUR_PREMIUM_PRICE_ID"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SIGNING_SECRET"
PREMIUM_GATING="off"
FREE_DECK_LIMIT="25"

# Socket.IO realtime CORS allowlist (comma-separated). If unset, realtime CORS falls back to '*'
# (any origin). Set this in production to lock it to your domain(s).
SOCKET_ALLOWED_ORIGINS="https://grimore.gg,https://www.grimore.gg"
